# Copier ce fichier en .env puis adapter les valeurs.

# Sécurité — générer une clé avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire-de-plus-de-40-caracteres
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000

# Base de données
POSTGRES_DB=easymaint
POSTGRES_USER=easymaint
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-solide

# Déploiement : onprem (une entreprise) ou saas (plusieurs entreprises par sous-domaine)
EASYMAINT_DEPLOYMENT_MODE=onprem
EASYMAINT_SAAS_BASE_DOMAIN=
EASYMAINT_USE_HTTPS=false
EASYMAINT_TIME_ZONE=Africa/Tunis
EASYMAINT_PORT=8000
# Heure de génération quotidienne des OT préventifs (0-23)
EASYMAINT_SCHEDULER_HOUR=2
# base = production ; dev = ajoute pytest dans l'image pour lancer les tests
EASYMAINT_REQUIREMENTS=dev

# Connexion : nombre d'échecs tolérés et durée du blocage (minutes)
EASYMAINT_LOGIN_MAX_FAILURES=5
EASYMAINT_LOGIN_LOCK_MINUTES=15
# true seulement si un proxy (Caddy, Nginx) est placé devant EasyMaint
EASYMAINT_BEHIND_PROXY=false

# Sauvegardes automatiques (service « backup ») : heure (0-23) et nombre de jours conservés
EASYMAINT_BACKUP_HOUR=1
EASYMAINT_BACKUP_KEEP_DAYS=14

# Langue de l'installation, choisie une fois pour toutes : fr (français) ou en (anglais).
# Toute l'entreprise travaille dans cette langue : écrans, documents PDF, exports Excel, rapports.
EASYMAINT_LANGUAGE=fr

# Adresse publique du code source, affichée dans « À propos » (par défaut : https://github.com/jugurthasoft/easymaint).
# À remplacer par l'adresse de VOTRE dépôt si vous proposez une version MODIFIÉE en ligne (licence AGPL-3.0).
# EASYMAINT_SOURCE_URL=

# --- Mode SaaS (en ligne) uniquement, voir docs/deploiement-cloud.md ---
# EASYMAINT_DEPLOYMENT_MODE=saas
# EASYMAINT_SAAS_BASE_DOMAIN=mondomaine.tn
# DJANGO_ALLOWED_HOSTS=.mondomaine.tn
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.mondomaine.tn,https://mondomaine.tn
# EASYMAINT_USE_HTTPS=true
# EASYMAINT_BEHIND_PROXY=true
# EASYMAINT_ACME_EMAIL=contact@mondomaine.tn
# EASYMAINT_REQUIREMENTS=base
